{
  "_comment": "Rename to netwatch.conf (next to netwatch.py) to enable. All keys optional. Restart NetWatch after editing.",

  "pihole_ips": ["192.168.1.2", "192.168.1.3"],
  "_pihole_ips": "Your Pi-hole IP(s). Any device sending plain DNS (port 53) to something NOT in this list is flagged as a DNS bypass. You can also pass these with --pihole on the command line.",

  "ignore_devices": ["192.168.1.2", "192.168.1.3"],
  "_ignore_devices": "LAN device IPs to exclude COMPLETELY - not listed, mapped, flagged, or alerted. Put infrastructure here (your Pi-hole/unbound resolvers, a VPN gateway, etc.) since a recursive resolver legitimately talks to thousands of nameservers worldwide and would otherwise flood the map and alerts. Can also pass with --ignore on the command line.",

  "learn_minutes": 30,
  "_learn_minutes": "Warm-up window. During this time NetWatch learns each device's normal countries/destinations silently and does NOT send new-country alerts, so you don't get flooded on first start. Threat and bypass alerts still fire immediately.",

  "alert_new_dest": false,
  "_alert_new_dest": "If true, also alert on every brand-new destination IP/host per device. Off by default because CDNs rotate IPs constantly and this gets noisy. New-country, threat, and bypass alerts are always on.",

  "weekly_digest": false,
  "_weekly_digest": "If true (and email is configured below), emails a weekly summary - top talkers, countries, alert counts, and threat hits from the past 7 days. The first digest arrives one week after enabling.",

  "notify": {
    "_comment": "Remove any channel you don't want. In-app alerts (the bell) always work regardless of these.",

    "ntfy_url": "https://ntfy.sh/your-secret-topic-name",
    "_ntfy_url": "Easiest push option. Install the ntfy app, subscribe to this topic (use a long random name, or self-host ntfy on the Pi). Delete this line to disable.",

    "webhook_url": "https://example.com/hook",
    "_webhook_url": "Optional. NetWatch POSTs the alert as JSON here (for Home Assistant, Discord/Slack via a relay, etc.). Delete to disable.",

    "email": {
      "_comment": "Optional SMTP email. This file stays on your Pi; the password is only read locally. Use an app-password, not your main password.",
      "smtp_host": "smtp.gmail.com",
      "smtp_port": 587,
      "username": "you@gmail.com",
      "password": "your-app-password",
      "from": "you@gmail.com",
      "to": "you@gmail.com",
      "levels": ["critical", "warning", "notice"]
    }
  }
}
